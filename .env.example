# Keeper 支持 CPA v8.0.12+。
# Keeper supports CPA v8.0.12+.
# =============================================================================
# 1. 最小必填 / Minimum required
# =============================================================================

# Keeper 服务端访问 CPA 的地址。Docker Compose 内通常是 http://cli-proxy-api:8317。必填：是。默认值：无。
# URL used by the Keeper server to call CPA. In Docker Compose this is usually http://cli-proxy-api:8317. Required: yes. Default: none.
CPA_BASE_URL=http://127.0.0.1:8317

# CPA management key，用于拉取管理接口数据。必填：是。默认值：无。
# CPA management key used to access management endpoints. Required: yes. Default: none.
CPA_MANAGEMENT_KEY=replace-with-your-management-key


# =============================================================================
# 2. Web 访问与反代 / Web access and reverse proxy
# =============================================================================

# HTTP 服务监听主机；留空保持现有行为，监听所有可用网络接口。原生部署仅本机访问可设为 127.0.0.1；Docker/Compose 请保持为空并通过宿主机端口绑定限制访问。必填：否。默认值：空。
# HTTP listen host; leave empty to preserve the existing behavior of listening on all available interfaces. Native deployments can use 127.0.0.1 for local-only access; Docker/Compose should leave this empty and restrict the published host port instead. Required: no. Default: empty.
APP_HOST=

# HTTP 服务监听端口。必填：否。默认值：8080。
# HTTP listen port for the application. Required: no. Default: 8080.
APP_PORT=8080

# Keeper 部署子路径；留空表示部署在根路径 /。如需子路径，必须以 / 开头，例如 /keeper；/keeper/ 会规范为 /keeper。
# Keeper subpath prefix; leave empty to serve from /. For subpath deployment, start with /, for example /keeper; /keeper/ is normalized to /keeper.
APP_BASE_PATH=

# 浏览器访问 CPA 的公开地址，用于“返回 CPA”跳转。留空时使用当前页面同源根路径并追加 /management.html。
# Public CPA URL for the "Back to CPA" link. When empty, the current page origin is used and /management.html is appended.
CPA_PUBLIC_URL=

# 除本机 loopback 外允许提供 X-Forwarded-For 的代理 CIDR，多个值用逗号分隔。仅填写实际反向代理地址或网段，禁止使用 0.0.0.0/0 或 ::/0。必填：否。默认值：空。
# Proxy CIDRs, in addition to local loopback, that may supply X-Forwarded-For; separate multiple values with commas. List only actual reverse-proxy addresses or networks; 0.0.0.0/0 and ::/0 are rejected. Required: no. Default: empty.
TRUSTED_PROXY_CIDRS=


# =============================================================================
# 3. 登录保护 / Login protection
# =============================================================================

# 是否启用登录保护。仅在访问范围已由部署环境可靠隔离时才显式关闭。必填：否。默认值：true。
# Whether to enable login protection. Disable it explicitly only when the deployment environment reliably isolates access. Required: no. Default: true.
AUTH_ENABLED=true

# 登录密码；启用登录保护时必填。示例保持为空，设置私有密码前服务会拒绝启动。默认值：无。
# Login password; required when login protection is enabled. The example stays empty so the service refuses to start until a private password is set. Default: none.
LOGIN_PASSWORD=

# 登录 session 的有效时长。必填：否。默认值：168h。
# Lifetime of the login session. Required: no. Default: 168h.
AUTH_SESSION_TTL=168h

# 可选的 OIDC 管理员登录，使用标准 Discovery、Authorization Code 和 PKCE S256。仍须启用 AUTH_ENABLED 并设置 LOGIN_PASSWORD。
# Optional OIDC admin login using Discovery, Authorization Code and PKCE S256. AUTH_ENABLED and LOGIN_PASSWORD are still required.
AUTH_OIDC_ENABLED=false
# 每次发起 OIDC 登录时要求身份平台重新认证；false 允许复用平台现有登录状态，不影响已建立的 Keeper 会话。
# Request reauthentication for each OIDC login; false allows the provider to reuse its login session. Existing Keeper sessions are unaffected.
AUTH_OIDC_PROMPT_LOGIN=true
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# 在 IdP 精确注册的 Keeper 公开回调地址，例如 https://keeper.example.com/keeper/api/v1/auth/oidc/callback。
# Exact public Keeper callback registered at the IdP, for example https://keeper.example.com/keeper/api/v1/auth/oidc/callback.
# Issuer 和回调均接受显式 HTTP/HTTPS；推荐 HTTPS，HTTP 链路没有传输加密。反向代理须保留公开 Host 和协议。
# Issuer and callback accept explicit HTTP/HTTPS; HTTPS is recommended because HTTP has no transport encryption. Reverse proxies must preserve the public host and scheme.
AUTH_OIDC_REDIRECT_URL=

# 可选的精确 subject 限制，JSON 字符串数组；sub 区分大小写，不是邮箱或用户名。例如 '["user-123","user,456"]'。
# Optional exact subject restriction as a JSON string array; sub is case-sensitive and is not an email or username. Example: '["user-123","user,456"]'.
# 空数组让 IdP 管理应用准入；所有通过该客户端认证的用户都成为 Keeper 管理员。
# An empty array delegates application access to the IdP; every user authenticated for this client becomes a Keeper administrator.
AUTH_OIDC_ALLOWED_SUBJECTS='[]'

# 允许管理员通过 Keeper 查看和下载 CPA 请求日志；需 CPA 存在对应日志，内容可能包含请求或响应数据。默认关闭。
# Allow administrators to view and download CPA request logs through Keeper. Logs must exist in CPA and may contain request or response data. Disabled by default.
CPA_REQUEST_LOG_ACCESS_ENABLED=false


# =============================================================================
# 4. 时区与请求行为 / Timezone and request behavior
# =============================================================================

# 项目业务时区，影响 Today、按天聚合、页面时间、日志时间和每日清理时间。必填：否。默认值：Asia/Shanghai。
# Project business timezone. Affects Today, daily aggregation, page timestamps, log timestamps, and daily cleanup. Required: no. Default: Asia/Shanghai.
TZ=Asia/Shanghai

# 请求 CPA HTTP 接口和 Redis 队列的超时时间。必填：否。默认值：30s。
# Timeout for CPA HTTP requests and Redis queue operations. Required: no. Default: 30s.
REQUEST_TIMEOUT=30s

# 是否跳过 CPA HTTPS 和 Redis 队列 TLS 的证书验证；仅在使用自签名证书时启用。必填：否。默认值：false。
# Whether to skip TLS certificate verification for CPA HTTPS and Redis queue TLS connections; enable only with self-signed certificates. Required: no. Default: false.
TLS_SKIP_VERIFY=false


# =============================================================================
# 5. Credentials 限额刷新 / Credentials quota refresh
# =============================================================================

# Credentials 限额刷新队列的最大并发数，手动刷新和定时刷新共用，最大 100。调大可以更快刷新大量账号，但也会增加上游限流和本地 SQLite 读压力。必填：否。默认值：10。
# Maximum concurrency for the shared Credentials quota refresh queue used by both manual and scheduled refresh, capped at 100. Increase it to refresh many accounts faster, but it may raise upstream rate-limit and local SQLite read pressure. Required: no. Default: 10.
QUOTA_REFRESH_WORKER_LIMIT=10

# 是否将限额查询收到的原始上游响应保存在最新凭证缓存，并通过 quota task/cache API 返回，供浏览器 F12 Network 排障。响应可能包含账号信息，仅在受保护环境中临时启用。必填：否。默认值：false。
# Whether to cache raw upstream quota responses in each credential's latest entry and return them through quota task/cache APIs for browser Network debugging. Responses may contain account data; enable only in protected environments. Required: no. Default: false.
QUOTA_UPSTREAM_RESPONSES_ENABLED=false


# =============================================================================
# 6. Redis 队列高级配置 / Redis queue advanced settings
# =============================================================================

# CPA Redis/RESP TCP 地址。显式设置时优先使用该地址；留空时沿用 CPA_BASE_URL 的主机和显式端口，未指定端口时使用 8317。独立地址填写 host:port。
# CPA Redis/RESP TCP address. An explicit value takes precedence; otherwise use the CPA_BASE_URL hostname and explicit port, or 8317 if no port is specified. Set host:port for a separate address.
REDIS_QUEUE_ADDR=

# 是否使用 TLS 连接 Redis 队列；显式设置 REDIS_QUEUE_ADDR 且需要 TLS 时设为 true。必填：否。默认值：false。
# Whether to use TLS for the Redis queue connection; set true when REDIS_QUEUE_ADDR is explicit and requires TLS. Required: no. Default: false.
REDIS_QUEUE_TLS=false

# 每次 Redis LPOP 最多拉取的队列记录数。必填：否。默认值：10000。
# Maximum queue records per Redis LPOP. Required: no. Default: 10000.
REDIS_QUEUE_BATCH_SIZE=10000

# Redis 队列为空时的 idle 检查间隔。必填：否。默认值：1s。
# Idle check interval when the Redis queue is empty. Required: no. Default: 1s.
REDIS_QUEUE_IDLE_INTERVAL=1s


# =============================================================================
# 7. 存储、日志与备份 / Storage, logs, and backups
# =============================================================================

# 应用工作目录，SQLite 数据库、日志和备份默认都写入这里。Docker 中 ./data 对应 /data；二进制中相对路径按 .env 所在目录解析。必填：否。默认值：./data。
# Application work directory. SQLite database, logs, and backups are stored here by default. In Docker ./data maps to /data; for binaries, relative paths are resolved against the .env file directory. Required: no. Default: ./data.
WORK_DIR=./data

# 应用日志级别。必填：否。默认值：info。
# Application log level. Required: no. Default: info.
LOG_LEVEL=info

# 是否写入持久化日志文件。必填：否。默认值：true。
# Whether to write persistent log files. Required: no. Default: true.
LOG_FILE_ENABLED=true

# 综合日志文件保留历史天数，并额外保留当天；0 表示不自动清理；仅错误日志固定保留历史 30 天及当天。必填：否。默认值：7。
# Number of historical days to retain combined logs, plus the current day; 0 disables cleanup; error-only logs keep 30 history days plus the current day. Required: no. Default: 7.
LOG_RETENTION_DAYS=7

# 是否启用 SQLite 数据库备份。必填：否。默认值：true。
# Whether to enable SQLite database backups. Required: no. Default: true.
BACKUP_ENABLED=true

# 数据库备份间隔。必填：否。默认值：24h。
# Database backup interval. Required: no. Default: 24h.
BACKUP_INTERVAL=24h

# 备份文件保留天数。必填：否。默认值：7。
# Number of days to retain backup files. Required: no. Default: 7.
BACKUP_RETENTION_DAYS=7

# 原始请求总保留天数（按请求时间计算），仅清理归档表；热表始终保留 90 个本地自然日。
# 0=永久保留归档（默认）；>=90=清理超期归档；负数和 1~89 按 0 处理并记录警告。
# 历史汇总及备份采用各自的保留策略；删除的明细无法用于历史重算。
USAGE_RAW_RETENTION_DAYS=0


# =============================================================================
# 8. 内置 HTTPS / Built-in HTTPS
# =============================================================================

# 是否让 Keeper 进程直接启用 HTTPS/TLS。通常建议在反向代理层处理 HTTPS。必填：否。默认值：false。
# Whether Keeper should serve HTTPS/TLS directly. Usually HTTPS should be terminated at the reverse proxy. Required: no. Default: false.
TLS_ENABLED=false

# HTTPS 证书文件路径。启用 TLS 时必填。支持相对 .env 所在目录的路径。默认值：无。
# HTTPS certificate file path. Required when TLS is enabled. Relative paths are resolved against the .env file directory. Default: none.
TLS_CERT_FILE=

# HTTPS 私钥文件路径。启用 TLS 时必填。支持相对 .env 所在目录的路径。默认值：无。
# HTTPS private key file path. Required when TLS is enabled. Relative paths are resolved against the .env file directory. Default: none.
TLS_KEY_FILE=
